# LibList Banking Backend - Environment Variables Template
# Copy this to .env or configure these variables in your deployment environment (Vercel / Railway / Render)

PORT=5000
NODE_ENV=production

# PostgreSQL Database Connection String (Neon DB / Supabase / AWS RDS)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/liblist_db?sslmode=require

# Groq LLM & AI Copilot
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# JWT Authentication & Security
JWT_ACCESS_SECRET=your_jwt_access_secret_super_secure_key
JWT_ACCESS_EXPIRY=15m
JWT_ISSUER=liblist-banking-auth
JWT_AUDIENCE=liblist-banking-users
REFRESH_TOKEN_DAYS=30
SHORT_SESSION_DAYS=1
BCRYPT_ROUNDS=10

# Allowed Frontend Client URL (CORS origin)
# For Vercel production: https://your-frontend-domain.vercel.app
CLIENT_URL=http://localhost:5173

# Email Service (SMTP / Nodemailer for OTP & Passwords)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Firebase Project Configuration
FIREBASE_PROJECT_ID=liblist-f60cc
